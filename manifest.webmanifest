{
  "id": "de.wheretowatch.app",
  "name": "Where to Watch – Dein Streaming Guide",
  "short_name": "Where to Watch",
  "description": "Dein Streaming Guide für Deutschland. Finde sofort heraus, welcher Dienst deine Lieblingsfilme im Flatrate-Abo oder kostenlos anbietet.",
  "start_url": "./index.html",
  "scope": "./",
